# Required for saving project enquiries to Neon Serverless PostgreSQL
# Get from https://console.neon.tech -> Connection Details -> Pooled connection
DATABASE_URL=

# Optional: Resend API key for instant email notifications on new enquiries
RESEND_API_KEY=

# Optional: Studio inbox email address that receives enquiry notifications
LEADS_NOTIFICATION_EMAIL=

# Optional: Verified sender email in Resend (e.g. "Dream Designers <enquiries@yourdomain.com>")
EMAIL_FROM=

# Public canonical URL of your deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://dreamdesigners.example.com
